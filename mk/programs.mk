# Build test binary (optimized)
$(TEST_BIN): $(TEST_SRC) $(LIB_STATIC) FORCE_OPT_LINK
	$(CC) $(CPPFLAGS) $(CFLAGS) $(CFLAGS_OPT) $< -L$(BUILD_DIR) -lgeobolt $(LDFLAGS) $(OPT_LDLIBS) $(THREAD_LIBS) -o $@

$(DATABASE_TEST_BIN): $(DATABASE_TEST_SRC) $(TEST_SUPPORT_SRC) $(LIB_STATIC) FORCE_OPT_LINK
	$(CC) $(CPPFLAGS) $(CFLAGS) $(CFLAGS_OPT) $(DATABASE_TEST_SRC) $(TEST_SUPPORT_SRC) -L$(BUILD_DIR) -lgeobolt \
		$(LDFLAGS) $(OPT_LDLIBS) $(THREAD_LIBS) -o $@

$(STORAGE_TEST_BIN): $(STORAGE_TEST_SRC) $(TEST_SUPPORT_SRC) $(LIB_STATIC) FORCE_OPT_LINK
	$(CC) $(CPPFLAGS) -I$(TEST_DIR) $(CFLAGS) $(CFLAGS_OPT) $(STORAGE_TEST_SRC) $(TEST_SUPPORT_SRC) -L$(BUILD_DIR) -lgeobolt \
		$(LDFLAGS) $(OPT_LDLIBS) $(THREAD_LIBS) -o $@

$(SERVER_TEST_BIN): $(SERVER_TEST_SRC) $(TEST_SUPPORT_SRC) $(LIB_STATIC) FORCE_OPT_LINK
	$(CC) $(CPPFLAGS) $(CFLAGS) $(CFLAGS_OPT) $(SERVER_TEST_SRC) $(TEST_SUPPORT_SRC) -L$(BUILD_DIR) -lgeobolt \
		$(LDFLAGS) $(OPT_LDLIBS) $(THREAD_LIBS) -o $@

$(DAEMON_BIN): $(DAEMON_SRC) $(LIB_STATIC) FORCE_OPT_LINK
	$(CC) $(CPPFLAGS) $(CFLAGS) $(CFLAGS_OPT) $(DAEMON_SRC) -L$(BUILD_DIR) -lgeobolt \
		$(LDFLAGS) $(OPT_LDLIBS) $(THREAD_LIBS) -o $@

