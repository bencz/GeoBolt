	$(CC) $(CPPFLAGS) $(CFLAGS) $(CFLAGS_OPT) $(DAEMON_TEST_SRC) $(TEST_SUPPORT_SRC) -L$(BUILD_DIR) -lgeobolt \
		$(LDFLAGS) $(OPT_LDLIBS) $(THREAD_LIBS) -o $@

